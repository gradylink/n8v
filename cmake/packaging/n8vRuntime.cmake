include_guard(GLOBAL)
include(GNUInstallDirs)

if(WIN32)
  enable_language(RC)
endif()

function(n8v_embed_manifest TARGET)
  if(NOT WIN32)
    return()
  endif()
  set(_manifest "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/n8v.manifest")
  set(_rc "${CMAKE_CURRENT_BINARY_DIR}/${TARGET}_n8v_manifest.rc")
  file(GENERATE OUTPUT "${_rc}" CONTENT "1 24 \"${_manifest}\"\n")
  set_source_files_properties("${_rc}" PROPERTIES GENERATED TRUE OBJECT_DEPENDS "${_manifest}")
  target_sources(${TARGET} PRIVATE "${_rc}")
endfunction()

function(n8v_install_runtime)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "DESTINATION;COMPONENT" "")
  get_property(_files GLOBAL PROPERTY N8V_RUNTIME_DLLS)
  if(NOT _files)
    return()
  endif()
  if(NOT ARG_DESTINATION)
    set(ARG_DESTINATION "${CMAKE_INSTALL_BINDIR}")
  endif()
  set(_component "")
  if(ARG_COMPONENT)
    set(_component COMPONENT "${ARG_COMPONENT}")
  endif()
  install(FILES ${_files} DESTINATION "${ARG_DESTINATION}" ${_component})
endfunction()

function(n8v_copy_runtime TARGET)
  get_property(_files GLOBAL PROPERTY N8V_RUNTIME_DLLS)
  if(NOT _files)
    return()
  endif()
  get_property(_targets GLOBAL PROPERTY N8V_RUNTIME_DLL_TARGETS)
  foreach(_target ${_targets})
    add_dependencies(${TARGET} ${_target})
  endforeach()
  add_custom_command(TARGET ${TARGET} POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_if_different ${_files} "$<TARGET_FILE_DIR:${TARGET}>"
    COMMAND_EXPAND_LISTS
    VERBATIM
  )
endfunction()
