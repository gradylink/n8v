@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/n8vTargets.cmake")

set_and_check(N8V_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(N8V_LIB_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

set(_n8v_had_GTK4 @N8V_HAVE_GTK4@)
set(_n8v_had_ADWAITA @N8V_HAVE_ADWAITA@)
set(_n8v_had_QT @N8V_HAVE_QT@)
set(_n8v_had_MILSKO @N8V_HAVE_MILSKO@)
set(_n8v_had_FLTK @N8V_HAVE_FLTK@)
set(_n8v_had_STATIC @N8V_BUILD_STATIC@)

if(_n8v_had_STATIC AND NOT TARGET n8v::n8v)
  add_library(n8v::n8v STATIC IMPORTED GLOBAL)

  set(_n8v_static_link_libs n8v::sdl2_lazy)
  if(_n8v_had_GTK4)
    list(APPEND _n8v_static_link_libs n8v::gtk4_lazy n8v::gobject_lazy n8v::glib_lazy)
    if(_n8v_had_ADWAITA)
      list(APPEND _n8v_static_link_libs n8v::adwaita_lazy)
    endif()
  endif()
  if(_n8v_had_QT)
    list(APPEND _n8v_static_link_libs n8v::qt6widgets_lazy n8v::qt6gui_lazy n8v::qt6core_lazy)
  endif()
  if(_n8v_had_MILSKO)
    list(APPEND _n8v_static_link_libs n8v::milsko_lazy)
  endif()
  if(_n8v_had_FLTK)
    list(APPEND _n8v_static_link_libs n8v::fltk_lazy)
  endif()

  set_target_properties(n8v::n8v PROPERTIES
    IMPORTED_LOCATION "${N8V_LIB_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}n8v${CMAKE_STATIC_LIBRARY_SUFFIX}"
    INTERFACE_INCLUDE_DIRECTORIES "${N8V_INCLUDE_DIR}"
    INTERFACE_LINK_LIBRARIES "${_n8v_static_link_libs}"
  )
  unset(_n8v_static_link_libs)
endif()

if(TARGET n8v::n8v_shared AND NOT TARGET n8v::n8v)
  add_library(n8v::n8v ALIAS n8v::n8v_shared)
endif()

foreach(_n8v_comp ${n8v_FIND_COMPONENTS})
  string(TOUPPER "${_n8v_comp}" _n8v_comp_upper)
  if(DEFINED _n8v_had_${_n8v_comp_upper})
    set(n8v_${_n8v_comp}_FOUND "${_n8v_had_${_n8v_comp_upper}}")
  else()
    set(n8v_${_n8v_comp}_FOUND FALSE)
    set(n8v_NOT_FOUND_MESSAGE "n8v: unknown component '${_n8v_comp}' (known: GTK4, ADWAITA, QT, MILSKO, FLTK)")
  endif()
endforeach()
unset(_n8v_comp_upper)

check_required_components(n8v)
