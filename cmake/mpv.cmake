set(N8V_HAVE_MPV FALSE)
option(N8V_MPV "Play audio and video with libmpv, if it is found at run time." ON)

if(N8V_MPV AND NOT EMSCRIPTEN)
  find_package(PkgConfig QUIET)
  if(PkgConfig_FOUND)
    pkg_check_modules(_N8V_PC_mpv QUIET mpv)
  endif()

  if(_N8V_PC_mpv_FOUND)
    set(N8V_HAVE_MPV TRUE)
    string(REGEX MATCH "^[0-9]+" _n8v_mpv_major "${_N8V_PC_mpv_VERSION}")
    set(_N8V_MPV_SYMBOLS
      mpv_create
      mpv_initialize
      mpv_terminate_destroy
      mpv_set_option_string
      mpv_set_property
      mpv_set_property_string
      mpv_get_property
      mpv_command
      mpv_wait_event
      mpv_set_wakeup_callback
      mpv_render_context_create
      mpv_render_context_render
      mpv_render_context_update
      mpv_render_context_set_update_callback
      mpv_render_context_free
    )
    lzy_add_wrapper(n8v_mpv_lazy
      LIBRARY_NAMES
        "libmpv.so.${_n8v_mpv_major}"
        "libmpv.so.2"
        "libmpv.so.1"
        "libmpv.so"
        "libmpv.${_n8v_mpv_major}.dylib"
        "libmpv.dylib"
        "libmpv-2.dll"
        "mpv-2.dll"
      SYMBOLS ${_N8V_MPV_SYMBOLS}
      REPLACE_PREFIX mpv_ n8v_mpv_
    )
    target_include_directories(n8v_mpv_lazy PUBLIC ${_N8V_PC_mpv_INCLUDE_DIRS})

    set(_N8V_MPV_NAMES_H "/* Generated by cmake/mpv.cmake. Do not edit by hand. */\n#pragma once\n")
    foreach(_sym IN LISTS _N8V_MPV_SYMBOLS)
      string(APPEND _N8V_MPV_NAMES_H "#define ${_sym} n8v_${_sym}\n")
    endforeach()
    set(N8V_MPV_GEN_DIR "${CMAKE_CURRENT_BINARY_DIR}/n8v_mpv_gen")
    file(CONFIGURE OUTPUT "${N8V_MPV_GEN_DIR}/n8v_mpv_names.h" CONTENT "${_N8V_MPV_NAMES_H}" @ONLY)
  else()
    message(STATUS "[n8v] libmpv development files not found - playback will use the toolkit's media support")
  endif()
endif()
