set(N8V_HAVE_FFMPEG FALSE)
option(N8V_FFMPEG "Play animations with FFmpeg, if its libraries are found at run time." ON)

if(N8V_FFMPEG AND NOT EMSCRIPTEN)
  find_package(PkgConfig QUIET)

  set(_N8V_FFMPEG_SYM_avutil
    av_dict_set
    av_dict_free
    av_frame_alloc
    av_frame_free
    av_log_set_level
  )
  set(_N8V_FFMPEG_SYM_avcodec
    avcodec_find_decoder
    avcodec_alloc_context3
    avcodec_parameters_to_context
    avcodec_open2
    avcodec_send_packet
    avcodec_receive_frame
    avcodec_flush_buffers
    avcodec_free_context
    av_packet_alloc
    av_packet_free
    av_packet_unref
  )
  set(_N8V_FFMPEG_SYM_avformat
    avformat_alloc_context
    avformat_open_input
    avformat_find_stream_info
    avformat_close_input
    av_find_best_stream
    av_read_frame
    av_seek_frame
  )
  set(_N8V_FFMPEG_SYM_swscale
    sws_getCachedContext
    sws_scale
    sws_freeContext
  )
  set(_N8V_FFMPEG_PFX_avutil av)
  set(_N8V_FFMPEG_PFX_avcodec av)
  set(_N8V_FFMPEG_PFX_avformat av)
  set(_N8V_FFMPEG_PFX_swscale sw)

  set(_N8V_FFMPEG_LIBS avutil avcodec avformat swscale)
  set(_N8V_FFMPEG_OK PkgConfig_FOUND)
  if(PkgConfig_FOUND)
    foreach(_lib IN LISTS _N8V_FFMPEG_LIBS)
      pkg_check_modules(_N8V_PC_${_lib} QUIET lib${_lib})
      if(NOT _N8V_PC_${_lib}_FOUND)
        set(_N8V_FFMPEG_OK FALSE)
      endif()
    endforeach()
  endif()

  if(_N8V_FFMPEG_OK)
    set(N8V_HAVE_FFMPEG TRUE)
    set(_N8V_FFMPEG_WRAPPER_TARGETS "")
    set(_N8V_FFMPEG_INCLUDE_DIRS "")
    set(_N8V_FFMPEG_ALL_SYMBOLS "")

    foreach(_lib IN LISTS _N8V_FFMPEG_LIBS)
      string(REGEX MATCH "^[0-9]+" _major "${_N8V_PC_${_lib}_VERSION}")
      set(_prefix "${_N8V_FFMPEG_PFX_${_lib}}")
      lzy_add_wrapper(n8v_${_lib}_lazy
        LIBRARY_NAMES
          "lib${_lib}.so.${_major}"
          "lib${_lib}.${_major}.dylib"
          "${_lib}-${_major}.dll"
        SYMBOLS ${_N8V_FFMPEG_SYM_${_lib}}
        REPLACE_PREFIX ${_prefix} n8v_${_prefix}
      )
      target_include_directories(n8v_${_lib}_lazy PUBLIC ${_N8V_PC_${_lib}_INCLUDE_DIRS})
      list(APPEND _N8V_FFMPEG_WRAPPER_TARGETS n8v_${_lib}_lazy)
      list(APPEND _N8V_FFMPEG_INCLUDE_DIRS ${_N8V_PC_${_lib}_INCLUDE_DIRS})
      list(APPEND _N8V_FFMPEG_ALL_SYMBOLS ${_N8V_FFMPEG_SYM_${_lib}})
    endforeach()
    list(REMOVE_DUPLICATES _N8V_FFMPEG_INCLUDE_DIRS)

    set(_N8V_FFMPEG_NAMES_H "/* Generated by cmake/ffmpeg.cmake. Do not edit by hand. */\n#pragma once\n")
    foreach(_sym IN LISTS _N8V_FFMPEG_ALL_SYMBOLS)
      string(APPEND _N8V_FFMPEG_NAMES_H "#define ${_sym} n8v_${_sym}\n")
    endforeach()
    set(N8V_FFMPEG_GEN_DIR "${CMAKE_CURRENT_BINARY_DIR}/n8v_ffmpeg_gen")
    file(CONFIGURE OUTPUT "${N8V_FFMPEG_GEN_DIR}/n8v_ffmpeg_names.h" CONTENT "${_N8V_FFMPEG_NAMES_H}" @ONLY)
  else()
    message(STATUS "[n8v] FFmpeg development files not found - animations will use the toolkit's media support")
  endif()
endif()
